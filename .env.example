# Proyecto Supabase (referencia). La app accede a la base de datos desde el
# servidor de Next.js con un rol de mínimo privilegio, nunca desde el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://qstaeonkrldmwiybxzkc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fUs7vUG_r-Zoxau6OOmDDA_KYCrhnj6

# Conexión administrativa (rol postgres): solo la usan los scripts de
# migración y datos demo (npm run db:*). Pooler en modo sesión.
DATABASE_ADMIN_URL=postgresql://postgres.qstaeonkrldmwiybxzkc:<DB_PASSWORD>@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Rol de aplicación (bh7_app). db:migrate lo crea/actualiza con esta clave.
APP_DB_PASSWORD=<CLAVE_ROL_APP>
# Conexión que usa la app en tiempo de ejecución (pooler en modo transacción).
DATABASE_URL=postgresql://bh7_app.qstaeonkrldmwiybxzkc:<CLAVE_ROL_APP>@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Firma de los JWT (HS256). Cambiarla invalida todas las sesiones.
JWT_SECRET=<SECRETO_ALEATORIO_LARGO>

# URL pública de la app (para el enlace de la clase de prueba y el QR).
NEXT_PUBLIC_APP_URL=http://localhost:3000
